# Silexx Voice Order Entry Assistant — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Silexx API ──────────────────────────────────────────────────────────────
# Base URL for the Silexx sandbox or production API
SILEXX_API_URL=

# API key for authenticating with Silexx (never log or expose this value)
SILEXX_API_KEY=

# Capabilities verified against this Silexx endpoint (comma-separated:
# idempotency, lookup, readBack). Set from tested behaviour, never from docs alone.
# Without lookup+readBack every success is reported as "populated, unverified".
SILEXX_CAPABILITIES=
# Hard timeout for one Silexx call; a timeout is an UNCERTAIN outcome, never a failure
SILEXX_TIMEOUT_MS=5000
# true = disable Silexx handoff for everyone (kill switch). Can only disable, never bypass.
HANDOFF_DISABLED=false

# ── Auth ─────────────────────────────────────────────────────────────────────
# HS256 secret used to sign and verify JWTs (min 32 chars recommended)
JWT_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 3001)
PORT=3001

# ── Store (drafts + hash-chained audit) ──────────────────────────────────────
# Sprint stand-in for PostgreSQL: JSON snapshot written on every commit.
# Verify the audit chain with: npm run audit:verify --workspace=server
DATA_PATH=data/store.json

# ── Sanity checks (inactive unless set; no default limits, D7) ───────────────
SANITY_MAX_QUANTITY=
SANITY_MAX_NOTIONAL=
# Window for "possible duplicate" warnings, in ms (default 10 minutes)
DUPLICATE_WINDOW_MS=600000

# ── Feature Flags ────────────────────────────────────────────────────────────
# Set to true ONLY for Iteration 2 NLP work; must remain false for MVP
ENABLE_NLP=false

# ── Iteration 2: Local LLM (NLP parsing) ─────────────────────────────────────
# Only used when ENABLE_NLP=true. Points at any OpenAI-compatible chat endpoint
# (Ollama, LM Studio, llama.cpp server). See docs/adr/001-local-llm-nlp.md.
# Base URL including the /v1 suffix (default: Ollama's local endpoint)
LLM_BASE_URL=http://localhost:11434/v1
# Model name as known to the local runtime
LLM_MODEL=llama3.1:8b
# Request timeout in milliseconds (default: 15000)
LLM_TIMEOUT_MS=15000
# Reject parses below this model-reported confidence (0-1, default: 0.6)
LLM_MIN_CONFIDENCE=0.6

# Silexx Voice Order Entry Assistant — Environment Variables
# Copy this file to .env and fill in real values. Never commit .env.

# ── Silexx API ──────────────────────────────────────────────────────────────
# Base URL for the Silexx sandbox or production API
SILEXX_API_URL=

# API key for authenticating with Silexx (never log or expose this value)
SILEXX_API_KEY=

# ── Auth ─────────────────────────────────────────────────────────────────────
# HS256 secret used to sign and verify JWTs (min 32 chars recommended)
JWT_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express server listens on (default: 3001)
PORT=3001

# ── Audit Log ────────────────────────────────────────────────────────────────
# Path to the append-only NDJSON audit log file (default: audit.ndjson in cwd)
AUDIT_LOG_PATH=audit.ndjson

# ── Feature Flags ────────────────────────────────────────────────────────────
# Set to true ONLY for Iteration 2 NLP work; must remain false for MVP
ENABLE_NLP=false

# ── Iteration 2: Local LLM (NLP parsing) ─────────────────────────────────────
# Only used when ENABLE_NLP=true. Points at any OpenAI-compatible chat endpoint
# (Ollama, LM Studio, llama.cpp server). See docs/adr/001-local-llm-nlp.md.
# Base URL including the /v1 suffix (default: Ollama's local endpoint)
LLM_BASE_URL=http://localhost:11434/v1
# Model name as known to the local runtime
LLM_MODEL=llama3.1:8b
# Request timeout in milliseconds (default: 15000)
LLM_TIMEOUT_MS=15000
# Reject parses below this model-reported confidence (0-1, default: 0.6)
LLM_MIN_CONFIDENCE=0.6
